@using System.Linq
@using System.Collections.Generic
@using coursework_2.Models
@model DietPlan
@{
    bool canEdit = ViewBag.CanEdit != null && (bool)ViewBag.CanEdit;
    bool isClient = User.IsInRole("Client");
    var foods = ViewBag.Foods as List<Food>;
    var logs = ViewBag.Logs as List<MealLog>;
    var dayNames = new[] { "Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday" };
}

@if (TempData["Success"] != null)
{
    <div class="mb-4 rounded-md bg-success px-4 py-3 text-sm text-white">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="mb-4 rounded-md bg-danger px-4 py-3 text-sm text-white">@TempData["Error"]</div>
}
@if (TempData["Warning"] != null)
{
    <div class="mb-4 rounded-md px-4 py-3 text-sm" style="background-color:#fef3c7;color:#92400e;border:1px solid #fcd34d;">
        @TempData["Warning"]
    </div>
}

<div class="card mb-6">
    <div class="card-body flex flex-wrap gap-6 justify-between">
        <div>
            <p class="text-default-500 text-sm mb-1">Daily target</p>
            <h4 class="text-lg font-semibold text-default-900">@Model.DailyCalorieTarget kcal</h4>
            <p class="text-default-500 text-sm mt-2">Client: @(Model.Client != null ? Model.Client.FullName : "-")</p>
            <p class="text-default-500 text-sm">Trainer: @(Model.Trainer != null ? Model.Trainer.FullName : "-")</p>
        </div>
        <div class="text-sm">
            <p class="text-default-500 mb-1">Dates</p>
            <p class="text-default-800">@Model.StartDate.ToString("dd MMM yyyy") - @(Model.EndDate.HasValue ? Model.EndDate.Value.ToString("dd MMM yyyy") : "open")</p>
            <span class="inline-block mt-2 px-2 py-1 rounded-md text-xs @(Model.Status == "Active" ? "bg-success" : "bg-gray-500") text-white">@Model.Status</span>
        </div>
        @if (canEdit)
        {
            <div class="flex gap-2 items-start">
                <a class="btn btn-sm bg-light text-gray-800" href="@Url.Action("Form", "Diets", new { id = Model.DietPlanId })">Edit</a>
                @using (Html.BeginForm("Delete", "Diets", new { id = Model.DietPlanId }, FormMethod.Post, new { onsubmit = "return confirm('Delete this diet plan?');" }))
                {
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm bg-danger text-white">Delete</button>
                }
            </div>
        }
    </div>
</div>

@if (canEdit && foods != null)
{
    <div class="card mb-6">
        <div class="card-header"><h4 class="card-title">Add Meal</h4></div>
        <div class="card-body">
            <p class="text-default-500 text-sm mb-4">
                Daily target: <strong>@Model.DailyCalorieTarget kcal</strong>. A meal is rejected if it would push that day over the target.
            </p>
            @using (Html.BeginForm("AddMeal", "Diets", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="planId" value="@Model.DietPlanId" />

                <div class="grid md:grid-cols-3 gap-4">
                    <div>
                        <label class="block text-sm mb-1">Meal</label>
                        <select name="mealType" class="form-input" required>
                            @foreach (var t in new[] { "Breakfast", "Lunch", "Dinner", "Snack" })
                            {
                                <option value="@t">@t</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm mb-1">Day</label>
                        <select name="dayOfWeek" class="form-input" required>
                            @for (byte d = 0; d < 7; d++)
                            {
                                <option value="@d">@dayNames[d]</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm mb-1">Food</label>
                        <input list="food-list" name="foodName" class="form-input" required placeholder="Type or pick a food" />
                        <datalist id="food-list">
                            @foreach (var f in foods)
                            {
                                <option value="@f.Name">@f.Calories.ToString("0") kcal</option>
                            }
                        </datalist>
                    </div>
                    <div>
                        <label class="block text-sm mb-1">Calories per serving</label>
                        <input type="number" step="1" min="1" max="3000" name="calories" class="form-input" value="200" required />
                    </div>
                    <div>
                        <label class="block text-sm mb-1">Quantity</label>
                        <input type="number" step="0.25" min="0.25" max="20" name="quantity" class="form-input" value="1" required />
                    </div>
                    <div>
                        <label class="block text-sm mb-1">Time (optional)</label>
                        <input type="time" name="mealTime" class="form-input" />
                    </div>
                </div>

                <button type="submit" class="btn bg-primary text-white mt-4">Add meal</button>
            }
        </div>
    </div>
}

<div class="grid lg:grid-cols-2 gap-6">
    @for (byte d = 0; d < 7; d++)
    {
        var items = Model.Meals.Where(m => m.DayOfWeek == d)
                               .OrderBy(m => m.MealTime.HasValue ? m.MealTime.Value : TimeSpan.Zero)
                               .ToList();
        if (items.Count == 0) { continue; }

        decimal dayCalories = items.Sum(i => i.Food != null ? i.Food.Calories * i.Quantity : 0);

        <div class="card">
            <div class="card-header flex justify-between items-center">
                <h4 class="card-title">@dayNames[d]</h4>
                <span class="text-sm text-default-500">@dayCalories.ToString("0") / @Model.DailyCalorieTarget kcal</span>
            </div>
            <div class="card-body">
                <ul class="divide-y divide-gray-200">
                    @foreach (var m in items)
                    {
                        <li class="py-3">
                            <div class="flex justify-between items-start gap-3">
                                <div>
                                    <p class="text-xs uppercase text-default-500 mb-1">@m.MealType</p>
                                    <p class="text-sm font-medium text-default-800">@(m.Food != null ? m.Food.Name : "-")</p>
                                    <p class="text-sm text-default-500">
                                        @m.Quantity.ToString("0.##") serving(s)
                                        @if (m.Food != null)
                                        {
                                            <span> - @((m.Food.Calories * m.Quantity).ToString("0")) kcal</span>
                                        }
                                        @if (m.MealTime.HasValue)
                                        {
                                            <span> at @m.MealTime.Value.ToString("hh\\:mm")</span>
                                        }
                                    </p>
                                </div>

                                @if (canEdit)
                                {
                                    using (Html.BeginForm("RemoveMeal", "Diets", FormMethod.Post))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@m.DietPlanMealId" />
                                        <button type="submit" class="btn btn-sm bg-danger text-white">Remove</button>
                                    }
                                }
                                else if (isClient)
                                {
                                    using (Html.BeginForm("LogMeal", "Diets", FormMethod.Post))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@m.DietPlanMealId" />
                                        <button type="submit" class="btn btn-sm bg-primary text-white">Log today</button>
                                    }
                                }
                            </div>
                        </li>
                    }
                </ul>
            </div>
        </div>
    }
</div>

<div class="card mt-6">
    <div class="card-header"><h4 class="card-title">Recent Meal Logs</h4></div>
    <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-6 py-3 text-start text-sm text-default-500">Date</th>
                    <th class="px-6 py-3 text-start text-sm text-default-500">Meal</th>
                    <th class="px-6 py-3 text-start text-sm text-default-500">Food</th>
                    <th class="px-6 py-3 text-start text-sm text-default-500">Quantity</th>
                    <th class="px-6 py-3 text-start text-sm text-default-500">Calories</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
                @if (logs == null || logs.Count == 0)
                {
                    <tr><td colspan="5" class="px-6 py-4 text-sm text-default-500">No meals logged yet.</td></tr>
                }
                else
                {
                    foreach (var l in logs)
                    {
                        <tr>
                            <td class="px-6 py-3 text-sm">@l.LogDate.ToString("dd MMM yyyy")</td>
                            <td class="px-6 py-3 text-sm">@l.MealType</td>
                            <td class="px-6 py-3 text-sm">@(l.Food != null ? l.Food.Name : "-")</td>
                            <td class="px-6 py-3 text-sm">@l.Quantity.ToString("0.##")</td>
                            <td class="px-6 py-3 text-sm">@l.Calories.ToString("0")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>