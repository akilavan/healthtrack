@using coursework_2.Models
@model DietPlan

<div class="card">
    <div class="card-header"><h4 class="card-title">@ViewBag.Title</h4></div>
    <div class="card-body">
        @if (ViewBag.Error != null)
        {
            <div class="mb-4 rounded-md bg-danger px-4 py-3 text-sm text-white">@ViewBag.Error</div>
        }

        @if (ViewBag.HasClients == false)
        {
            <div class="mb-4 rounded-md bg-light px-4 py-3 text-sm text-default-700">
                No clients are assigned to you yet. Ask an administrator to assign a client before creating a plan.
            </div>
        }

        @using (Html.BeginForm("Form", "Diets", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@(Model.DietPlanId > 0 ? Model.DietPlanId.ToString() : "")" />

            <div class="grid md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm mb-1">Plan title</label>
                    <input type="text" name="title" maxlength="120" class="form-input" value="@Model.Title" required />
                </div>
                <div>
                    <label class="block text-sm mb-1">Client</label>
                    @Html.DropDownList("clientId", (SelectList)ViewBag.Clients, new { @class = "form-input", required = "required" })
                </div>
                <div>
                    <label class="block text-sm mb-1">Daily calorie target</label>
                    <input type="number" min="800" max="6000" name="dailyCalorieTarget" class="form-input"
                           value="@(Model.DailyCalorieTarget > 0 ? Model.DailyCalorieTarget.ToString() : "2000")" required />
                </div>
                <div>
                    <label class="block text-sm mb-1">Status</label>
                    <select name="status" class="form-input">
                        <option value="Active" selected="@(Model.Status == "Active")">Active</option>
                        <option value="Completed" selected="@(Model.Status == "Completed")">Completed</option>
                        <option value="Cancelled" selected="@(Model.Status == "Cancelled")">Cancelled</option>
                    </select>
                </div>
                <div>
                    <label class="block text-sm mb-1">Start date</label>
                    <input type="date" name="startDate" class="form-input" value="@Model.StartDate.ToString("yyyy-MM-dd")" required />
                </div>
                <div>
                    <label class="block text-sm mb-1">End date (optional)</label>
                    <input type="date" name="endDate" class="form-input" value="@(Model.EndDate.HasValue ? Model.EndDate.Value.ToString("yyyy-MM-dd") : "")" />
                </div>
            </div>

            <div class="mt-6 flex gap-2">
                <button type="submit" class="btn bg-primary text-white">Save plan</button>
                <a class="btn bg-light text-gray-800" href="@Url.Action("Index", "Diets")">Cancel</a>
            </div>
        }
    </div>
</div>