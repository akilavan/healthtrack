@using coursework_2.Models
@model User
@{
    var cp = Model.ClientProfile;
    var tp = Model.TrainerProfile;
}

@if (TempData["Success"] != null)
{
    <div class="mb-4 rounded-md bg-success px-4 py-3 text-sm text-white">@TempData["Success"]</div>
}

<div class="card">
    <div class="card-header"><h4 class="card-title">My Profile</h4></div>
    <div class="card-body">
        @if (ViewBag.Error != null)
        {
            <div class="mb-4 rounded-md bg-danger px-4 py-3 text-sm text-white">@ViewBag.Error</div>
        }

    <div class="flex items-center gap-4 mb-6">
        @if (!string.IsNullOrEmpty(Model.PhotoPath))
        {
            <img src="@Url.Content(Model.PhotoPath)" alt="@Model.FullName"
                 class="rounded-full size-16 object-cover" />
        }
        else
        {
            <span class="flex items-center justify-center rounded-full size-16 bg-primary text-white text-xl font-medium">
                @(string.IsNullOrEmpty(Model.FullName) ? "?" : Model.FullName.Substring(0, 1).ToUpper())
            </span>
        }
        <div>
            <p class="text-default-900 font-medium">@Model.FullName</p>
            <p class="text-sm text-default-500">@Model.Email - @Model.Role.RoleName</p>
            @if (coursework_2.Models.SmsService.Enabled)
            {
                <p class="text-xs mt-1">
                    @if (Model.PhoneVerified)
                    {
                        <span class="text-success">Phone verified</span>
                    }
                    else
                    {
                        <span class="text-danger">Phone not verified</span>
                    }
                </p>
            }
        </div>
    </div>

        @using (Html.BeginForm("Index", "Profile", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()
            <div class="mb-5">
                <label class="block text-sm mb-1">Profile picture</label>
                <input type="file" name="photo" class="form-input" accept=".png,.jpg,.jpeg,.gif,.webp" />
                <p class="text-default-500 text-xs mt-1">PNG, JPG, GIF or WEBP, max 3 MB.</p>
                @if (!string.IsNullOrEmpty(Model.PhotoPath))
                {
                <label class="flex items-center gap-2 text-sm text-default-700 mt-2">
                    <input type="checkbox" name="removePhoto" value="true" />
                    Remove current picture
                </label>
                }
            </div>

            <div class="grid md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm mb-1">Full name</label>
                    <input type="text" name="fullName" maxlength="120" class="form-input" value="@Model.FullName" required />
                </div>
                <div>
                    <label class="block text-sm mb-1">Phone</label>
                    <input type="text" name="phone" maxlength="12" class="form-input" value="@Model.Phone"
                           @(coursework_2.Models.SmsService.Enabled ? "required" : null)
                           pattern="(0[0-9]{9}|\+94[0-9]{9}|94[0-9]{9})"
                           title="10 digits starting 0, or +94 followed by 9 digits, or 94 followed by 9 digits" />
                </div>
                <div>
                    <label class="block text-sm mb-1">Gender</label>
                    <select name="gender" class="form-input">
                        <option value="">--</option>
                        @foreach (var g in new[] { "Male", "Female", "Other" })
                        {
                            <option value="@g" selected="@(Model.Gender == g ? "selected" : null)">@g</option>

                        }
                    </select>
                </div>
                <div>
                    <label class="block text-sm mb-1">Date of birth</label>
                    <input type="date" name="dateOfBirth" class="form-input" value="@(Model.DateOfBirth.HasValue ? Model.DateOfBirth.Value.ToString("yyyy-MM-dd") : "")" />
                </div>
            </div>

            if (Model.Role.RoleName == "Client")
            {
                <h5 class="text-default-900 font-medium mt-6 mb-3">Fitness Profile</h5>
                <div class="grid md:grid-cols-3 gap-4">
                    <div>
                        <label class="block text-sm mb-1">Height (cm)</label>
                        <input type="number" step="0.1" min="50" max="250" name="heightCm" class="form-input" value="@(cp != null && cp.HeightCm > 0 ? cp.HeightCm.ToString("0.0") : "")" />
                    </div>
                    <div>
                        <label class="block text-sm mb-1">Goal weight (kg)</label>
                        <input type="number" step="0.1" min="20" max="500" name="goalWeightKg" class="form-input" value="@(cp != null && cp.GoalWeightKg.HasValue ? cp.GoalWeightKg.Value.ToString("0.0") : "")" />
                    </div>
                    <div>
                        <label class="block text-sm mb-1">Activity level</label>
                        <select name="activityLevel" class="form-input">
                            @foreach (var a in new[] { "Sedentary", "Light", "Moderate", "High", "Athlete" })
                            {
                                <option value="@a" selected="@(cp != null && cp.ActivityLevel == a ? "selected" : null)">@a</option>
                            }
                        </select>
                    </div>
                    <div class="md:col-span-2">
                        <label class="block text-sm mb-1">Fitness goal</label>
                        <input type="text" name="fitnessGoal" maxlength="100" class="form-input" value="@(cp != null ? cp.FitnessGoal : "")" />
                    </div>
                    <div class="md:col-span-3">
                        <label class="block text-sm mb-1">Medical notes</label>
                        <textarea name="medicalNotes" maxlength="500" class="form-input" rows="3">@(cp != null ? cp.MedicalNotes : "")</textarea>
                    </div>
                </div>
            }

            if (Model.Role.RoleName == "Trainer")
            {
                <h5 class="text-default-900 font-medium mt-6 mb-3">Trainer Profile</h5>
                <div class="grid md:grid-cols-3 gap-4">
                    <div>
                        <label class="block text-sm mb-1">Specialization</label>
                        <input type="text" name="specialization" maxlength="100" class="form-input" value="@(tp != null ? tp.Specialization : "")" required />
                    </div>
                    <div>
                        <label class="block text-sm mb-1">Certification</label>
                        <input type="text" name="certification" maxlength="150" class="form-input" value="@(tp != null ? tp.Certification : "")" />
                    </div>
                    <div>
                        <label class="block text-sm mb-1">Years of experience</label>
                        <input type="number" min="0" max="60" name="yearsExperience" class="form-input" value="@(tp != null && tp.YearsExperience.HasValue ? tp.YearsExperience.ToString() : "")" />
                    </div>
                    <div class="md:col-span-3">
                        <label class="block text-sm mb-1">Bio</label>
                        <textarea name="bio" maxlength="500" class="form-input" rows="3">@(tp != null ? tp.Bio : "")</textarea>
                    </div>
                </div>
            }

            <button type="submit" class="btn bg-primary text-white mt-6">Save profile</button>
        }
    </div>
</div>