@using System.Collections.Generic
@using coursework_2.Models
@model List<HealthMetric>
@{
    bool isOwner = ViewBag.IsOwner != null && (bool)ViewBag.IsOwner;
}

@if (TempData["Success"] != null)
{
    <div class="mb-4 rounded-md bg-success px-4 py-3 text-sm text-white">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="mb-4 rounded-md bg-danger px-4 py-3 text-sm text-white">@TempData["Error"]</div>
}

<div class="card mb-6">
    <div class="card-header"><h4 class="card-title">Weight Trend - @ViewBag.ClientName</h4></div>
    <div class="card-body">
        @if (Model == null || Model.Count == 0)
        {
            <p class="text-default-500 text-sm">No measurements yet.</p>
        }
        else
        {
            <div id="weight-chart"></div>
        }
    </div>
</div>

@if (isOwner)
{
    <div class="card mb-6">
        <div class="card-header"><h4 class="card-title">Add Measurement</h4></div>
        <div class="card-body">
            @using (Html.BeginForm("Add", "Progress", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <div class="grid md:grid-cols-3 gap-4">
                    <div>
                        <label class="block text-sm mb-1">Weight (kg)</label>
                        <input type="number" step="0.1" min="20" max="500" name="weightKg" class="form-input" required />
                    </div>
                    <div>
                        <label class="block text-sm mb-1">Body fat %</label>
                        <input type="number" step="0.1" min="1" max="70" name="bodyFatPct" class="form-input" />
                    </div>
                    <div>
                        <label class="block text-sm mb-1">Measured at</label>
                        <input type="datetime-local" name="measuredAt" class="form-input" />
                    </div>
                    <div>
                        <label class="block text-sm mb-1">Systolic BP</label>
                        <input type="number" min="60" max="250" name="systolicBP" class="form-input" />
                    </div>
                    <div>
                        <label class="block text-sm mb-1">Diastolic BP</label>
                        <input type="number" min="40" max="150" name="diastolicBP" class="form-input" />
                    </div>
                    <div>
                        <label class="block text-sm mb-1">Resting HR</label>
                        <input type="number" min="30" max="220" name="restingHR" class="form-input" />
                    </div>
                    <div>
                        <label class="block text-sm mb-1">Blood sugar</label>
                        <input type="number" step="0.1" min="1" max="40" name="bloodSugar" class="form-input" />
                    </div>
                    <div class="md:col-span-2">
                        <label class="block text-sm mb-1">Notes</label>
                        <input type="text" name="notes" maxlength="250" class="form-input" />
                    </div>
                </div>
                <button type="submit" class="btn bg-primary text-white mt-4">Save measurement</button>
            }
        </div>
    </div>
}

<div class="card">
    <div class="card-header"><h4 class="card-title">Measurements</h4></div>
    <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-6 py-3 text-start text-sm text-default-500">Date</th>
                    <th class="px-6 py-3 text-start text-sm text-default-500">Weight</th>
                    <th class="px-6 py-3 text-start text-sm text-default-500">BMI</th>
                    <th class="px-6 py-3 text-start text-sm text-default-500">Body fat</th>
                    <th class="px-6 py-3 text-start text-sm text-default-500">BP</th>
                    <th class="px-6 py-3 text-start text-sm text-default-500">HR</th>
                    <th class="px-6 py-3 text-start text-sm text-default-500">Notes</th>
                    @if (isOwner)
                    {
                        <th class="px-6 py-3 text-end text-sm text-default-500"></th>
                    }
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
                @if (Model == null || Model.Count == 0)
                {
                    <tr><td colspan="8" class="px-6 py-4 text-sm text-default-500">No measurements yet.</td></tr>
                }
                else
                {
                    foreach (var m in Model)
                    {
                        <tr>
                            <td class="px-6 py-3 text-sm">@m.MeasuredAt.ToString("dd MMM yyyy")</td>
                            <td class="px-6 py-3 text-sm">@m.WeightKg.ToString("0.0") kg</td>
                            <td class="px-6 py-3 text-sm">@(m.BMI.HasValue ? m.BMI.Value.ToString("0.0") : "-")</td>
                            <td class="px-6 py-3 text-sm">@(m.BodyFatPct.HasValue ? m.BodyFatPct.Value.ToString("0.0") + "%" : "-")</td>
                            <td class="px-6 py-3 text-sm">@(m.SystolicBP.HasValue ? m.SystolicBP + "/" + m.DiastolicBP : "-")</td>
                            <td class="px-6 py-3 text-sm">@(m.RestingHR.HasValue ? m.RestingHR.ToString() : "-")</td>
                            <td class="px-6 py-3 text-sm">@m.Notes</td>
                            @if (isOwner)
                            {
                                <td class="px-6 py-3 text-sm text-end">
                                    @using (Html.BeginForm("Delete", "Progress", new { id = m.MetricId }, FormMethod.Post, new { onsubmit = "return confirm('Delete this measurement?');" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm bg-danger text-white">Delete</button>
                                    }
                                </td>
                            }
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@section scripts {
    <script>
        (function () {
            var el = document.querySelector("#weight-chart");
            if (!el) return;

            var labels = "@ViewBag.ChartLabels".split(",");
            var data = "@ViewBag.ChartWeights".split(",").map(Number);

            new ApexCharts(el, {
                chart: { type: "line", height: 300, toolbar: { show: false } },
                series: [{ name: "Weight (kg)", data: data }],
                xaxis: { categories: labels },
                stroke: { curve: "smooth", width: 3 },
                colors: ["#8b5cf6"],
                markers: { size: 4 },
                dataLabels: { enabled: false },
                grid: { strokeDashArray: 4 }
            }).render();
        })();
    </script>
}