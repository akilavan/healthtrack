@using coursework_2.Models
@model User

<div class="card">
    <div class="card-header"><h4 class="card-title">@ViewBag.Title</h4></div>
    <div class="card-body">
        @if (ViewBag.Error != null)
        {
            <div class="mb-4 rounded-md bg-danger px-4 py-3 text-sm text-white">@ViewBag.Error</div>
        }

        @using (Html.BeginForm("Form", "Users", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@(Model.UserId > 0 ? Model.UserId.ToString() : "")" />

            <div class="grid md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm mb-1">Full name</label>
                    <input type="text" name="fullName" maxlength="120" class="form-input" value="@Model.FullName" required />
                </div>
                <div>
                    <label class="block text-sm mb-1">Email</label>
                    <input type="email" name="email" maxlength="150" class="form-input" value="@Model.Email" required />
                </div>
                <div>
                    <label class="block text-sm mb-1">Role</label>
                    @Html.DropDownList("roleId", (SelectList)ViewBag.Roles, new { @class = "form-input", required = "required" })
                </div>
                <div>
                    <label class="block text-sm mb-1">Phone</label>
                    <input type="text" name="phone" maxlength="12" class="form-input" value="@Model.Phone"
                           pattern="(0[0-9]{9}|\+94[0-9]{9}|94[0-9]{9})"
                           title="10 digits starting 0, or +94 followed by 9 digits, or 94 followed by 9 digits" />
                </div>
                <div>
                    <label class="block text-sm mb-1">Gender</label>
                    <select name="gender" class="form-input">
                        <option value="">--</option>
                        @foreach (var g in new[] { "Male", "Female", "Other" })
                        {
                            <option value="@g" selected="@(Model.Gender == g ? "selected" : null)">@g</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="block text-sm mb-1">Date of birth</label>
                    <input type="date" name="dateOfBirth" class="form-input" value="@(Model.DateOfBirth.HasValue ? Model.DateOfBirth.Value.ToString("yyyy-MM-dd") : "")" />
                </div>
                <div>
                    <label class="block text-sm mb-1">@(Model.UserId > 0 ? "New password (optional)" : "Password")</label>
                    <input type="password" name="password" class="form-input" minlength="8" autocomplete="new-password"
                           @(Model.UserId == 0 ? "required" : null)
                           pattern="(?=.*[A-Z])(?=.*[0-9])(?=.*[^A-Za-z0-9\s]).{8,}"
                           title="At least 8 characters with an uppercase letter, a number and a special character"
                           placeholder="@(Model.UserId > 0 ? "Leave blank to keep current" : "At least 8 chars, 1 uppercase, 1 number, 1 special")" />
                    <p class="text-default-500 text-xs mt-1">At least 8 characters, including an uppercase letter, a number and a special character.</p>
                </div>
                <div class="flex items-center gap-2 mt-6">
                    <input type="checkbox" name="isActive" value="true" class="form-checkbox" checked="@(Model.IsActive ? "checked" : null)" />
                    <label class="text-sm">Active account</label>
                </div>
            </div>

            <div class="mt-6 flex gap-2">
                <button type="submit" class="btn bg-primary text-white">Save</button>
                <a class="btn bg-light text-gray-800" href="@Url.Action("Index", "Users")">Cancel</a>
            </div>
        }
    </div>
</div>