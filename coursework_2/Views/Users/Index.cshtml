@using coursework_2.Models
@model List<User>

@if (TempData["Success"] != null)
{
    <div class="mb-4 rounded-md bg-success px-4 py-3 text-sm text-white">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="mb-4 rounded-md bg-danger px-4 py-3 text-sm text-white">@TempData["Error"]</div>
}

<div class="card">
    <div class="card-header flex flex-wrap gap-3 justify-between items-center">
        <h4 class="card-title">Users</h4>
        <a href="@Url.Action("Form", "Users")" class="btn btn-sm bg-primary text-white">New User</a>
    </div>

    <div class="card-body">
        <form method="get" action="@Url.Action("Index", "Users")" class="flex flex-wrap gap-2">
            <input type="text" name="q" value="@ViewBag.Query" class="form-input w-full md:w-72" placeholder="Search name or email" />
            <select name="roleId" class="form-input w-full md:w-48">
                <option value="">All roles</option>
                @foreach (var r in (SelectList)ViewBag.Roles)
                {
                    <option value="@r.Value" selected="@(ViewBag.RoleId != null && ViewBag.RoleId.ToString() == r.Value ? "selected" : null)">@r.Text</option>
                }
            </select>
            <button type="submit" class="btn bg-primary text-white">Filter</button>
        </form>
    </div>

    <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>

                    <th class="px-6 py-3 text-start text-sm text-default-500">Name</th>
                    <th class="px-6 py-3 text-start text-sm text-default-500">Email</th>
                    <th class="px-6 py-3 text-start text-sm text-default-500">Role</th>
                    <th class="px-6 py-3 text-start text-sm text-default-500">Phone</th>
                    <th class="px-6 py-3 text-start text-sm text-default-500">Status</th>
                    <th class="px-6 py-3 text-start text-sm text-default-500">Created</th>
                    <th class="px-6 py-3 text-end text-sm text-default-500">Actions</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
                @if (Model == null || Model.Count == 0)
                {
                    <tr><td colspan="7" class="px-6 py-4 text-sm text-default-500">No users found.</td></tr>
                }
                else
                {
                    foreach (var u in Model)
                    {
            <tr>
                <td class="px-6 py-3 text-sm text-default-800">
                    <div class="flex items-center gap-2">
                        @if (!string.IsNullOrEmpty(u.PhotoPath))
                        {
                            <img src="@Url.Content(u.PhotoPath)" alt="@u.FullName" class="rounded-full h-10 w-10 object-cover" />
                        }
                        else
                        {
                            <span class="flex items-center justify-center rounded-full h-10 w-10 bg-primary text-white text-xs font-medium">
                                @(string.IsNullOrEmpty(u.FullName) ? "?" : u.FullName.Substring(0, 1).ToUpper())
                            </span>
                        }
                        <span>@u.FullName</span>
                    </div>
                </td>
                <td class="px-6 py-3 text-sm text-default-800">@u.FullName</td>
                <td class="px-6 py-3 text-sm">@u.Email</td>
                <td class="px-6 py-3 text-sm">@(u.Role != null ? u.Role.RoleName : "-")</td>
                <td class="px-6 py-3 text-sm">@u.Phone</td>
                <td class="px-6 py-3 text-sm">
                    <span class="inline-block px-2 py-1 rounded-md text-xs @(u.IsActive ? "bg-success" : "bg-gray-500") text-white">@(u.IsActive ? "Active" : "Inactive")</span>
                </td>
                <td class="px-6 py-3 text-sm">@u.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                <td class="px-6 py-3 text-sm text-end">
                    <a class="btn btn-sm bg-light text-gray-800" href="@Url.Action("Form", "Users", new { id = u.UserId })">Edit</a>
                    @using (Html.BeginForm("ToggleActive", "Users", new { id = u.UserId }, FormMethod.Post, new { @class = "inline" }))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm bg-primary text-white">@(u.IsActive ? "Deactivate" : "Activate")</button>
                    }
                    @using (Html.BeginForm("Delete", "Users", new { id = u.UserId }, FormMethod.Post, new { @class = "inline", onsubmit = "return confirm('Delete this user permanently?');" }))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm bg-danger text-white">Delete</button>
                    }
                </td>
            </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>