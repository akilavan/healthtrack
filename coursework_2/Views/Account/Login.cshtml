@{
    ViewBag.Title = "Login";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
    var appSettings = coursework_2.Models.SettingsService.Current;
}

<div class="card w-full shadow-lg" style="max-width:430px;">
    <div class="p-6">

        <div class="text-center mb-6">
            <a href="@Url.Action("Index", "Home")" class="inline-block">
                <img src="@Url.Content(string.IsNullOrEmpty(appSettings.LogoPath) ? "~/assets/images/logo-dark.png" : appSettings.LogoPath)"
                     alt="@appSettings.CompanyName" style="height:80px;" class="mx-auto">
            </a>
            <h4 class="text-default-900 text-xl font-medium mt-4 mb-1">Welcome back</h4>
            <p class="text-sm text-default-700">Sign in to your @appSettings.CompanyName account</p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="bg-danger text-sm text-white rounded-md p-4 mb-4" role="alert">
                @ViewBag.Error
            </div>
        }

        @using (Html.BeginForm("Login", "Account", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div class="mb-4">
                <label for="Email" class="text-default-800 text-sm font-medium inline-block mb-2">Email</label>
                <input type="email" id="Email" name="Email" class="form-input"
                       placeholder="you@example.com" required autofocus>
            </div>

            <div class="mb-4">
                <label for="Password" class="text-default-800 text-sm font-medium inline-block mb-2">Password</label>
                <input type="password" id="Password" name="Password" class="form-input"
                       placeholder="Enter your password" required>
            </div>

            <div class="flex items-center justify-between mb-4">
                <div class="form-check">
                    <input type="checkbox" id="RememberMe" name="RememberMe"
                           class="form-checkbox rounded text-primary" value="true">
                    <label class="ms-1.5 text-sm" for="RememberMe">Remember me</label>
                </div>
                <a href="#" class="text-sm text-primary">Forgot password?</a>
            </div>

            if (coursework_2.Models.RecaptchaService.Enabled)
            {
                <div class="mb-4">
                    <div class="g-recaptcha" data-sitekey="@coursework_2.Models.RecaptchaService.SiteKey"></div>
                </div>
            }

            <button type="submit" class="btn bg-primary text-white w-full">Sign In</button>
        }

        <p class="text-center text-sm text-default-700 mt-4">
            Don't have an account?
            <a href="@Url.Action("Register", "Account")" class="text-primary font-medium">Register</a>
        </p>
    </div>
</div>

@if (coursework_2.Models.RecaptchaService.Enabled)
{
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
}