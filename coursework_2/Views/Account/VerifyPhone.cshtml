@{
    ViewBag.Title = "Verify Phone";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";

    bool hasPhone = ViewBag.HasPhone != null && (bool)ViewBag.HasPhone;
    string phone = ViewBag.Phone as string;
    string company = (ViewBag.CompanyName as string) ?? "HealthTrack";
    DateTime? sentAt = ViewBag.CodeSentAt as DateTime?;
}

<div class="card w-full shadow-lg" style="max-width:430px;">
    <div class="p-6">

        <div class="text-center mb-6">
            <h4 class="text-default-900 text-xl font-medium mb-1">Verify your phone</h4>
            <p class="text-sm text-default-700">
                @if (hasPhone)
                {
                    <span>Enter the 6-digit code sent to <strong>@phone</strong>.</span>
                }
                else
                {
                    <span>Add a phone number to receive your verification code.</span>
                }
            </p>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="bg-success text-sm text-white rounded-md p-4 mb-4" role="alert">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="bg-danger text-sm text-white rounded-md p-4 mb-4" role="alert">@TempData["Error"]</div>
        }
        @if (ViewBag.Error != null)
        {
            <div class="bg-danger text-sm text-white rounded-md p-4 mb-4" role="alert">@ViewBag.Error</div>
        }

        @if (!hasPhone)
        {
            <a href="@Url.Action("Index", "Profile")" class="btn bg-primary text-white w-full">Add phone number in profile</a>
        }
        else
        {
            <form action="@Url.Action("VerifyPhone", "Account")" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-4">
                    <label class="text-default-800 text-sm font-medium inline-block mb-2" for="code">Verification code</label>
                    <input id="code" name="code" class="form-input text-center" inputmode="numeric"
                           pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" required
                           placeholder="000000" />
                    @if (sentAt.HasValue)
                    {
                        <p class="text-default-500 text-xs mt-1">Sent @sentAt.Value.ToString("dd MMM HH:mm") · expires in 10 minutes.</p>
                    }
                </div>

                <button type="submit" class="btn bg-primary text-white w-full">Verify phone</button>
            </form>

            <form action="@Url.Action("ResendPhoneCode", "Account")" method="post" class="mt-3 text-center">
                @Html.AntiForgeryToken()
                <button type="submit" class="text-sm text-primary">Resend code</button>
            </form>
        }

        <div class="mt-6 pt-4 border-t border-default-200 text-center">
            <a href="@Url.Action("Logout", "Account")" class="text-sm text-default-500">Sign out</a>
        </div>

        <p class="text-center text-xs text-default-400 mt-4">@company</p>
    </div>
</div>
