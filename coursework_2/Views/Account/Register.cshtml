@{
    ViewBag.Title = "Register";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
    var appSettings = coursework_2.Models.SettingsService.Current;
}

<div class="card w-full shadow-lg" style="max-width:460px;">
    <div class="p-6">

        <div class="text-center mb-6">
            <a href="@Url.Action("Index", "Home")" class="inline-block">
                <img src="@Url.Content(string.IsNullOrEmpty(appSettings.LogoPath) ? "~/assets/images/logo-dark.png" : appSettings.LogoPath)"
                     alt="@appSettings.CompanyName" style="height:80px;" class="mx-auto">
            </a>
            <h4 class="text-default-900 text-xl font-medium mt-4 mb-1">Create an account</h4>
            <p class="text-sm text-default-700">Join HealthTrack today</p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="bg-danger text-sm text-white rounded-md p-4 mb-4" role="alert">
                @ViewBag.Error
            </div>
        }

        @using (Html.BeginForm("Register", "Account", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div class="mb-4">
                <label for="FullName" class="text-default-800 text-sm font-medium inline-block mb-2">Full Name</label>
                <input type="text" id="FullName" name="FullName" class="form-input"
                       placeholder="Kamal Silva" required>
            </div>

            <div class="mb-4">
                <label for="Email" class="text-default-800 text-sm font-medium inline-block mb-2">Email</label>
                <input type="email" id="Email" name="Email" class="form-input"
                       placeholder="you@example.com" required>
            </div>

            <div class="mb-4">
                <label for="Phone" class="text-default-800 text-sm font-medium inline-block mb-2">Phone</label>
                <input type="tel" id="Phone" name="Phone" class="form-input"
                       placeholder="0712345678 or +94712345678"
                       pattern="(0[0-9]{9}|\+94[0-9]{9}|94[0-9]{9})"
                       maxlength="12"
                       @(coursework_2.Models.SmsService.Enabled ? "required" : null)
                       title="10 digits starting 0, or +94 followed by 9 digits, or 94 followed by 9 digits">
            </div>

            <div class="mb-4">
                <label for="DateOfBirth" class="text-default-800 text-sm font-medium inline-block mb-2">Date of Birth</label>
                <input type="date" id="DateOfBirth" name="DateOfBirth" class="form-input">
            </div>

            <div class="mb-4">
                <label for="Gender" class="text-default-800 text-sm font-medium inline-block mb-2">Gender</label>
                <select id="Gender" name="Gender" class="form-input">
                    <option value="">-- Select --</option>
                    <option value="Male">Male</option>
                    <option value="Female">Female</option>
                    <option value="Other">Other</option>
                </select>
            </div>

            <div class="mb-4">
                <label for="Role" class="text-default-800 text-sm font-medium inline-block mb-2">Register as</label>
                <select id="Role" name="Role" class="form-input" required>
                    <option value="Client">Client</option>
                    <option value="Trainer">Trainer</option>
                </select>
            </div>

            <div class="mb-4">
                <label for="Password" class="text-default-800 text-sm font-medium inline-block mb-2">Password</label>
                <input type="password" id="Password" name="Password" class="form-input"
                       placeholder="At least 8 characters, 1 uppercase, 1 number, 1 special"
                       minlength="8" pattern="(?=.*[A-Z])(?=.*[0-9])(?=.*[^A-Za-z0-9\s]).{8,}"
                       title="At least 8 characters with an uppercase letter, a number and a special character" required>
                <p class="text-default-500 text-xs mt-1">At least 8 characters, including an uppercase letter, a number and a special character.</p>
            </div>

            <div class="mb-4">
                <label for="ConfirmPassword" class="text-default-800 text-sm font-medium inline-block mb-2">Confirm Password</label>
                <input type="password" id="ConfirmPassword" name="ConfirmPassword" class="form-input"
                       placeholder="Re-enter your password" minlength="8" required>
            </div>

            if (coursework_2.Models.RecaptchaService.Enabled)
            {
                <div class="mb-4">
                    <div class="g-recaptcha" data-sitekey="@coursework_2.Models.RecaptchaService.SiteKey"></div>
                </div>
            }

            <button type="submit" class="btn bg-primary text-white w-full">Create Account</button>
        }

        <p class="text-center text-sm text-default-700 mt-4">
            Already have an account?
            <a href="@Url.Action("Login", "Account")" class="text-primary font-medium">Sign in</a>
        </p>
    </div>
</div>

@if (coursework_2.Models.RecaptchaService.Enabled)
{
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
}