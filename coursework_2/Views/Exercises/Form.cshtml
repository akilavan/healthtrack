@using coursework_2.Models
@model Exercise

<div class="card">
    <div class="card-header"><h4 class="card-title">@ViewBag.Title</h4></div>
    <div class="card-body">
        @if (ViewBag.Error != null)
        {
            <div class="mb-4 rounded-md bg-danger px-4 py-3 text-sm text-white">@ViewBag.Error</div>
        }

        @using (Html.BeginForm("Form", "Exercises", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@(Model.ExerciseId > 0 ? Model.ExerciseId.ToString() : "")" />

            <div class="grid md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm mb-1">Name</label>
                    <input type="text" name="name" maxlength="100" class="form-input" value="@Model.Name" required />
                </div>
                <div>
                    <label class="block text-sm mb-1">Category</label>
                    <select name="category" class="form-input" required>
                        @foreach (var c in new[] { "Strength", "Cardio", "Core", "Flexibility", "Balance" })
                        {
                            <option value="@c" selected="@(Model.Category == c ? "selected" : null)">@c</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="block text-sm mb-1">Muscle group</label>
                    <input type="text" name="muscleGroup" maxlength="50" class="form-input" value="@Model.MuscleGroup" />
                </div>
                <div>
                    <label class="block text-sm mb-1">MET value</label>
                    <input type="number" step="0.1" min="0.5" max="20" name="metValue" class="form-input"
                           value="@(Model.MetValue > 0 ? Model.MetValue.ToString("0.0") : "3.5")" required />
                    <p class="text-xs text-default-500 mt-1">3.5 = moderate effort, 6+ = vigorous</p>
                </div>
            </div>

            <div class="mt-6 flex gap-2">
                <button type="submit" class="btn bg-primary text-white">Save</button>
                <a class="btn bg-light text-gray-800" href="@Url.Action("Index", "Exercises")">Cancel</a>
            </div>
        }
    </div>
</div>
