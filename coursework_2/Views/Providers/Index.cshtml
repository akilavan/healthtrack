@using coursework_2.Models
@model List<HealthcareProvider>

@if (TempData["Success"] != null)
{
    <div class="mb-4 rounded-md bg-success px-4 py-3 text-sm text-white">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="mb-4 rounded-md bg-danger px-4 py-3 text-sm text-white">@TempData["Error"]</div>
}

<div class="card">
    <div class="card-header flex flex-wrap gap-3 justify-between items-center">
        <h4 class="card-title">Healthcare Providers</h4>
        <a href="@Url.Action("Form", "Providers")" class="btn btn-sm bg-primary text-white">New Provider</a>
    </div>

    <div class="card-body">
        <form method="get" action="@Url.Action("Index", "Providers")" class="flex flex-wrap gap-2">
            <input type="text" name="q" value="@ViewBag.Query" class="form-input w-full md:w-72" placeholder="Search name, specialty or clinic" />
            <button type="submit" class="btn bg-primary text-white">Filter</button>
        </form>
    </div>

    <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-6 py-3 text-start text-sm text-default-500">Name</th>
                    <th class="px-6 py-3 text-start text-sm text-default-500">Specialty</th>
                    <th class="px-6 py-3 text-start text-sm text-default-500">Clinic</th>
                    <th class="px-6 py-3 text-start text-sm text-default-500">Phone</th>
                    <th class="px-6 py-3 text-start text-sm text-default-500">Status</th>
                    <th class="px-6 py-3 text-end text-sm text-default-500">Actions</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
                @if (Model == null || Model.Count == 0)
                {
                    <tr><td colspan="6" class="px-6 py-4 text-sm text-default-500">No providers yet.</td></tr>
                }
                else
                {
                    foreach (var p in Model)
                    {
                        <tr>
                            <td class="px-6 py-3 text-sm text-default-800">@p.FullName</td>
                            <td class="px-6 py-3 text-sm">@p.Specialty</td>
                            <td class="px-6 py-3 text-sm">@p.Clinic</td>
                            <td class="px-6 py-3 text-sm">@p.Phone</td>
                            <td class="px-6 py-3 text-sm">
                                <span class="inline-block px-2 py-1 rounded-md text-xs @(p.IsActive ? "bg-success" : "bg-gray-500") text-white">@(p.IsActive ? "Active" : "Inactive")</span>
                            </td>
                            <td class="px-6 py-3 text-sm text-end">
                                <a class="btn btn-sm bg-light text-gray-800" href="@Url.Action("Form", "Providers", new { id = p.ProviderId })">Edit</a>
                                @using (Html.BeginForm("Delete", "Providers", new { id = p.ProviderId }, FormMethod.Post, new { @class = "inline", onsubmit = "return confirm('Delete this provider?');" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm bg-danger text-white">Delete</button>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>