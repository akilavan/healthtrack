@using coursework_2.Models
@model IEnumerable<LandingSection>
@{
    var landingEnabled = SettingsService.Current.LandingPageEnabled;
    var sections = Model == null ? new List<LandingSection>() : Model.ToList();
}

@if (TempData["Success"] != null)
{
    <div class="mb-4 rounded-md bg-success px-4 py-3 text-sm text-white">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="mb-4 rounded-md bg-danger px-4 py-3 text-sm text-white">@TempData["Error"]</div>
}

<div class="card mb-6">
    <div class="card-body flex flex-wrap items-center justify-between gap-4">
        <div>
            <h4 class="card-title mb-1">Public landing page</h4>
            <p class="text-default-500 text-sm mb-0">
                @if (landingEnabled)
                {
                    <span class="text-success font-medium">Enabled</span>
                    <span> - signed-out visitors see this page at the site root.</span>
                }
                else
                {
                    <span class="text-danger font-medium">Disabled</span>
                    <span> - signed-out visitors are sent to the login page.</span>
                }
            </p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
            <a href="@Url.Action("Index", "Settings")" class="btn bg-light text-gray-800">Landing settings</a>
            <a href="@Url.Action("Preview", "Home")" target="_blank" class="btn bg-light text-gray-800">Preview</a>
            @using (Html.BeginForm("CreateDefaults", "LandingAdmin", FormMethod.Post, new { @class = "inline" }))
            {
                @Html.AntiForgeryToken()
                <button type="submit" class="btn bg-light text-gray-800"
                        onclick="return confirm('Add the starter landing content? This only works when no sections exist.');">
                    Load starter content
                </button>
            }
            <a href="@Url.Action("Form", "LandingAdmin")" class="btn bg-primary text-white">Add section</a>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header flex flex-wrap items-center justify-between gap-3">
        <h4 class="card-title">Sections</h4>
        <span class="text-default-500 text-sm">@sections.Count section(s)</span>
    </div>
    <div class="card-body overflow-x-auto">
        @if (sections.Count == 0)
        {
            <div class="py-10 text-center">
                <span class="material-symbols-rounded text-default-400" style="font-size:44px;">web</span>
                <h5 class="mt-3 mb-2">No landing sections yet</h5>
                <p class="text-default-500 text-sm mb-4">Add a section manually or load the starter content to get going quickly.</p>
                <a href="@Url.Action("Form", "LandingAdmin")" class="btn bg-primary text-white">Add your first section</a>
            </div>
        }
        else
        {
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-4 py-3 text-start text-sm text-default-500">Order</th>
                        <th class="px-4 py-3 text-start text-sm text-default-500">Section</th>
                        <th class="px-4 py-3 text-start text-sm text-default-500">Heading</th>
                        <th class="px-4 py-3 text-start text-sm text-default-500">Items</th>
                        <th class="px-4 py-3 text-start text-sm text-default-500">Status</th>
                        <th class="px-4 py-3 text-end text-sm text-default-500">Actions</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    @for (int i = 0; i < sections.Count; i++)
                    {
                        var s = sections[i];
                        <tr>
                            <td class="px-4 py-3 text-sm whitespace-nowrap">
                                <div class="flex items-center gap-1">
                                    @using (Html.BeginForm("Move", "LandingAdmin", new { id = s.SectionId, direction = "up" }, FormMethod.Post, new { @class = "inline" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm bg-light text-gray-800" title="Move up" @(i == 0 ? "disabled" : null)>
                                            <span class="material-symbols-rounded text-base">arrow_upward</span>
                                        </button>
                                    }
                                    @using (Html.BeginForm("Move", "LandingAdmin", new { id = s.SectionId, direction = "down" }, FormMethod.Post, new { @class = "inline" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm bg-light text-gray-800" title="Move down" @(i == sections.Count - 1 ? "disabled" : null)>
                                            <span class="material-symbols-rounded text-base">arrow_downward</span>
                                        </button>
                                    }
                                    <span class="text-default-500 ms-1">@s.SortOrder</span>
                                </div>
                            </td>
                            <td class="px-4 py-3 text-sm whitespace-nowrap">
                                <span class="font-medium">@s.SectionType</span>
                                <div class="text-default-400 text-xs">@s.BackgroundStyle</div>
                            </td>
                            <td class="px-4 py-3 text-sm" style="max-width:320px;">
                                <div class="font-medium text-default-800">@s.Heading</div>
                                @if (!string.IsNullOrWhiteSpace(s.Subheading))
                                {
                                    <div class="text-default-500 text-xs mt-1">@s.Subheading</div>
                                }
                            </td>
                            <td class="px-4 py-3 text-sm whitespace-nowrap">
                                @if (LandingSection.SupportsItems(s.SectionType))
                                {
                                    <a href="@Url.Action("Items", "LandingAdmin", new { id = s.SectionId })" class="text-primary">
                                        @s.Items.Count item(s)
                                    </a>
                                }
                                else
                                {
                                    <span class="text-default-400">-</span>
                                }
                            </td>
                            <td class="px-4 py-3 text-sm whitespace-nowrap">
                                @if (s.IsPublished)
                                {
                                    <span class="inline-flex rounded-full bg-success/10 px-2 py-1 text-xs font-medium text-success">Published</span>
                                }
                                else
                                {
                                    <span class="inline-flex rounded-full bg-default-100 px-2 py-1 text-xs font-medium text-default-500">Hidden</span>
                                }
                            </td>
                            <td class="px-4 py-3 text-sm whitespace-nowrap text-end">
                                <div class="flex flex-wrap items-center justify-end gap-2">
                                    @if (LandingSection.SupportsItems(s.SectionType))
                                    {
                                        <a href="@Url.Action("Items", "LandingAdmin", new { id = s.SectionId })" class="btn btn-sm bg-light text-gray-800">Items</a>
                                    }
                                    <a href="@Url.Action("Form", "LandingAdmin", new { id = s.SectionId })" class="btn btn-sm bg-light text-gray-800">Edit</a>
                                    @using (Html.BeginForm("TogglePublish", "LandingAdmin", new { id = s.SectionId }, FormMethod.Post, new { @class = "inline" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm bg-light text-gray-800">
                                            @(s.IsPublished ? "Hide" : "Publish")
                                        </button>
                                    }
                                    @using (Html.BeginForm("Delete", "LandingAdmin", new { id = s.SectionId }, FormMethod.Post, new { @class = "inline" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm bg-danger/10 text-danger"
                                                onclick="return confirm('Delete this section and all of its items?');">
                                            Delete
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
