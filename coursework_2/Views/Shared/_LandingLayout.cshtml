@using coursework_2.Models
@{
    var appSettings = SettingsService.Current;
    var logoUrl = string.IsNullOrEmpty(appSettings.LogoPath)
        ? Url.Content("~/assets/images/logo-dark.png")
        : Url.Content(appSettings.LogoPath);
}
<!DOCTYPE html>
<html lang="en">
<head>
    @Html.Partial("_TitleMeta")
    @Html.Partial("_HeadCss")
    <style>
        :root {
            --landing-primary: #8b5cf6;
            --landing-primary-dark: #7c3aed;
            --landing-ink: #111827;
            --landing-muted: #6b7280;
            --landing-border: #e5e7eb;
            --landing-soft: #f8f7ff;
        }

        .landing-body {
            margin: 0;
            background: #ffffff;
            color: var(--landing-ink);
            font-family: Inter, ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
            line-height: 1.6;
        }

        .landing-body *,
        .landing-body *::before,
        .landing-body *::after {
            box-sizing: border-box;
        }

        .landing-body a {
            text-decoration: none;
        }

        .landing-container {
            width: 100%;
            max-width: 1120px;
            margin: 0 auto;
            padding: 0 24px;
        }

        .landing-header {
            position: sticky;
            top: 0;
            z-index: 40;
            background: rgba(255,255,255,0.94);
            border-bottom: 1px solid var(--landing-border);
            backdrop-filter: blur(12px);
        }

        .landing-header-inner {
            min-height: 78px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 24px;
        }

        .landing-logo img {
            display: block;
            height: 56px;
            width: auto;
        }

        .landing-nav {
            display: flex;
            align-items: center;
            gap: 26px;
        }

        .landing-nav a {
            color: #374151;
            font-size: 14px;
            font-weight: 600;
        }

        .landing-nav a:hover {
            color: var(--landing-primary-dark);
        }

        .landing-header-actions {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .landing-preview-bar {
            background: #111827;
            color: #ffffff;
            font-size: 13px;
            padding: 10px 24px;
            text-align: center;
        }

        .landing-preview-bar a {
            color: #c4b5fd;
            font-weight: 700;
            margin-left: 6px;
        }

        .landing-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            min-height: 46px;
            padding: 0 22px;
            border-radius: 12px;
            border: 1px solid transparent;
            font-size: 14px;
            font-weight: 700;
            line-height: 1;
            transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease;
        }

        .landing-btn:hover {
            transform: translateY(-1px);
        }

        .landing-btn-sm {
            min-height: 38px;
            padding: 0 16px;
            border-radius: 10px;
            font-size: 13px;
        }

        .landing-btn-primary {
            background: var(--landing-primary);
            color: #ffffff;
        }

        .landing-btn-primary:hover {
            background: var(--landing-primary-dark);
            color: #ffffff;
        }

        .landing-btn-ghost {
            background: #ffffff;
            border-color: #d1d5db;
            color: #374151;
        }

        .landing-btn-ghost:hover {
            border-color: var(--landing-primary);
            color: var(--landing-primary-dark);
        }

        .landing-btn-light {
            background: rgba(255,255,255,0.14);
            border-color: rgba(255,255,255,0.35);
            color: #ffffff;
        }

        .landing-btn-light:hover {
            background: rgba(255,255,255,0.22);
            color: #ffffff;
        }

        .landing-section {
            padding: 88px 0;
            scroll-margin-top: 82px;
        }

        .landing-bg-light {
            background: #ffffff;
        }

        .landing-bg-muted {
            background: var(--landing-soft);
        }

        .landing-bg-primary {
            background: linear-gradient(135deg, #7c3aed 0%, #8b5cf6 52%, #a78bfa 100%);
            color: #ffffff;
        }

        .landing-bg-dark {
            background: #111827;
            color: #ffffff;
        }

        .landing-bg-primary .landing-eyebrow,
        .landing-bg-dark .landing-eyebrow {
            color: #ede9fe;
        }

        .landing-bg-primary .landing-lead,
        .landing-bg-dark .landing-lead,
        .landing-bg-primary .landing-section-intro,
        .landing-bg-dark .landing-section-intro,
        .landing-bg-primary .landing-copy,
        .landing-bg-dark .landing-copy {
            color: rgba(255,255,255,0.82);
        }

        .landing-section-head {
            max-width: 720px;
            margin: 0 auto 44px;
            text-align: center;
        }

        .landing-eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            color: var(--landing-primary-dark);
            font-size: 12px;
            font-weight: 800;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            margin-bottom: 14px;
        }

        .landing-section h2,
        .landing-hero h1 {
            margin: 0;
            color: inherit;
            letter-spacing: -0.035em;
            line-height: 1.08;
        }

        .landing-section h2 {
            font-size: clamp(30px, 4vw, 44px);
            font-weight: 800;
        }

        .landing-hero {
            display: grid;
            grid-template-columns: minmax(0, 1.1fr) minmax(280px, 0.9fr);
            gap: 58px;
            align-items: center;
        }

        .landing-hero h1 {
            font-size: clamp(40px, 5.6vw, 68px);
            font-weight: 850;
            max-width: 720px;
        }

        .landing-lead {
            margin: 22px 0 0;
            color: var(--landing-muted);
            font-size: clamp(17px, 2vw, 20px);
            line-height: 1.65;
            max-width: 620px;
        }

        .landing-copy {
            margin: 14px 0 0;
            color: var(--landing-muted);
            font-size: 15px;
            line-height: 1.7;
        }

        .landing-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin-top: 30px;
        }

        .landing-trust {
            display: flex;
            flex-wrap: wrap;
            gap: 16px;
            margin-top: 26px;
            color: var(--landing-muted);
            font-size: 13px;
        }

        .landing-trust span {
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .landing-hero-art {
            padding: 18px;
            border-radius: 26px;
            background: rgba(255,255,255,0.14);
            border: 1px solid rgba(255,255,255,0.3);
            box-shadow: 0 30px 70px rgba(17,24,39,0.24);
        }

        .landing-hero-art-inner {
            background: #ffffff;
            color: var(--landing-ink);
            border-radius: 18px;
            padding: 22px;
        }

        .landing-art-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin-bottom: 22px;
        }

        .landing-art-title {
            font-size: 14px;
            font-weight: 800;
        }

        .landing-art-subtitle {
            color: var(--landing-muted);
            font-size: 12px;
        }

        .landing-art-dots {
            display: flex;
            gap: 5px;
        }

        .landing-art-dots span {
            width: 8px;
            height: 8px;
            border-radius: 999px;
            background: #ddd6fe;
        }

        .landing-art-dots span:first-child {
            background: var(--landing-primary);
        }

        .landing-progress-row {
            display: flex;
            align-items: center;
            gap: 18px;
        }

        .landing-ring {
            width: 108px;
            height: 108px;
            border-radius: 50%;
            background: conic-gradient(var(--landing-primary) 0 76%, #ede9fe 76% 100%);
            display: grid;
            place-items: center;
            flex: 0 0 auto;
        }

        .landing-ring-inner {
            width: 82px;
            height: 82px;
            border-radius: 50%;
            background: #ffffff;
            display: grid;
            place-items: center;
            text-align: center;
        }

        .landing-ring-value {
            display: block;
            font-size: 21px;
            font-weight: 850;
            line-height: 1.1;
        }

        .landing-ring-label {
            display: block;
            color: var(--landing-muted);
            font-size: 10px;
            margin-top: 3px;
        }

        .landing-art-metrics {
            display: grid;
            gap: 12px;
            flex: 1;
        }

        .landing-metric {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 11px 12px;
            border: 1px solid #f1f0f7;
            border-radius: 11px;
            background: #fcfbff;
            font-size: 12px;
        }

        .landing-metric strong {
            font-size: 13px;
        }

        .landing-art-bars {
            display: flex;
            align-items: flex-end;
            gap: 8px;
            height: 76px;
            margin-top: 24px;
            padding: 0 4px;
        }

        .landing-art-bars span {
            flex: 1;
            border-radius: 7px 7px 3px 3px;
            background: #ede9fe;
        }

        .landing-art-bars span:nth-child(4),
        .landing-art-bars span:nth-child(6) {
            background: var(--landing-primary);
        }

        .landing-art-image {
            width: 100%;
            display: block;
            border-radius: 18px;
            object-fit: cover;
        }

        .landing-section-intro {
            margin: 16px auto 0;
            color: var(--landing-muted);
            font-size: 16px;
            max-width: 660px;
        }

        .landing-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 22px;
        }

        .landing-card {
            padding: 26px;
            background: #ffffff;
            border: 1px solid var(--landing-border);
            border-radius: 18px;
            box-shadow: 0 12px 34px rgba(17,24,39,0.04);
        }

        .landing-card h3 {
            margin: 18px 0 8px;
            font-size: 18px;
            line-height: 1.35;
            color: var(--landing-ink);
        }

        .landing-card p {
            margin: 0;
            color: var(--landing-muted);
            font-size: 14px;
            line-height: 1.7;
        }

        .landing-card-image {
            width: 100%;
            height: 160px;
            object-fit: cover;
            border-radius: 12px;
            margin-bottom: 18px;
        }

        .landing-icon {
            width: 46px;
            height: 46px;
            border-radius: 13px;
            background: #ede9fe;
            color: var(--landing-primary-dark);
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        .landing-icon .material-symbols-rounded {
            font-size: 24px;
        }

        .landing-about {
            display: grid;
            grid-template-columns: minmax(0, 1fr) minmax(280px, 0.9fr);
            gap: 54px;
            align-items: center;
        }

        .landing-about-panel {
            min-height: 290px;
            border-radius: 24px;
            background: linear-gradient(140deg, #ede9fe, #ffffff);
            border: 1px solid #ddd6fe;
            padding: 30px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            gap: 28px;
        }

        .landing-about-panel-icon {
            width: 58px;
            height: 58px;
            display: grid;
            place-items: center;
            border-radius: 18px;
            background: var(--landing-primary);
            color: #ffffff;
        }

        .landing-about-points {
            display: grid;
            gap: 12px;
        }

        .landing-about-points span {
            display: flex;
            align-items: center;
            gap: 9px;
            color: #374151;
            font-size: 13px;
            font-weight: 600;
        }

        .landing-about-points .material-symbols-rounded {
            color: var(--landing-primary-dark);
            font-size: 19px;
        }

        .landing-about-image {
            width: 100%;
            height: 100%;
            min-height: 290px;
            object-fit: cover;
            border-radius: 24px;
            border: 1px solid #ddd6fe;
        }

        .landing-stat-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 20px;
        }

        .landing-stat {
            padding: 28px;
            text-align: center;
            border: 1px solid var(--landing-border);
            border-radius: 18px;
            background: #ffffff;
        }

        .landing-stat-value {
            display: block;
            color: var(--landing-primary-dark);
            font-size: clamp(34px, 4vw, 48px);
            font-weight: 850;
            letter-spacing: -0.04em;
            line-height: 1;
        }

        .landing-stat-label {
            display: block;
            margin-top: 11px;
            color: var(--landing-muted);
            font-size: 14px;
        }

        .landing-quote {
            position: relative;
            padding-top: 42px;
        }

        .landing-quote-mark {
            position: absolute;
            top: 16px;
            left: 24px;
            color: #ddd6fe;
            font-family: Georgia, serif;
            font-size: 60px;
            line-height: 1;
        }

        .landing-quote p {
            position: relative;
            margin: 0 0 18px;
            color: #374151;
            font-size: 15px;
            line-height: 1.75;
        }

        .landing-quote strong {
            color: var(--landing-ink);
            font-size: 14px;
        }

        .landing-faq {
            max-width: 840px;
            margin: 0 auto;
        }

        .landing-faq details {
            margin-bottom: 12px;
            padding: 20px 24px;
            background: #ffffff;
            border: 1px solid var(--landing-border);
            border-radius: 14px;
        }

        .landing-faq summary {
            cursor: pointer;
            color: var(--landing-ink);
            font-size: 15px;
            font-weight: 700;
            list-style: none;
            padding-right: 24px;
            position: relative;
        }

        .landing-faq summary::-webkit-details-marker {
            display: none;
        }

        .landing-faq summary::after {
            content: "+";
            position: absolute;
            right: 0;
            top: -3px;
            color: var(--landing-primary);
            font-size: 24px;
            font-weight: 400;
        }

        .landing-faq details[open] summary::after {
            content: "\2212";
        }

        .landing-faq details p {
            margin: 13px 0 0;
            color: var(--landing-muted);
            font-size: 14px;
            line-height: 1.7;
        }

        .landing-cta {
            text-align: center;
            max-width: 760px;
            margin: 0 auto;
        }

        .landing-cta h2 {
            font-size: clamp(32px, 4.5vw, 50px);
        }

        .landing-cta .landing-actions {
            justify-content: center;
        }

        .landing-draft {
            display: inline-flex;
            margin-bottom: 16px;
            padding: 5px 10px;
            border-radius: 999px;
            background: rgba(17,24,39,0.75);
            color: #fef3c7;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.08em;
        }

        .landing-footer {
            background: #111827;
            color: #d1d5db;
            padding: 38px 0;
        }

        .landing-footer-inner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 24px;
            flex-wrap: wrap;
        }

        .landing-footer strong {
            color: #ffffff;
            font-size: 15px;
        }

        .landing-footer p {
            margin: 4px 0 0;
            color: #9ca3af;
            font-size: 13px;
        }

        .landing-footer-links {
            display: flex;
            flex-wrap: wrap;
            gap: 18px;
            color: #c4b5fd;
            font-size: 13px;
            font-weight: 600;
        }

        .landing-footer-links a {
            color: inherit;
        }

        @@media (max-width: 900px) {
            .landing-nav {
                display: none;
            }

            .landing-hero,
            .landing-about {
                grid-template-columns: 1fr;
                gap: 36px;
            }

            .landing-grid,
            .landing-stat-grid {
                grid-template-columns: 1fr 1fr;
            }

            .landing-hero-art {
                max-width: 520px;
            }
        }

        @@media (max-width: 620px) {
            .landing-container {
                padding: 0 18px;
            }

            .landing-header-inner {
                min-height: 68px;
            }

            .landing-logo img {
                height: 46px;
            }

            .landing-header-actions .landing-btn-ghost {
                display: none;
            }

            .landing-section {
                padding: 62px 0;
            }

            .landing-grid,
            .landing-stat-grid {
                grid-template-columns: 1fr;
            }

            .landing-hero h1 {
                font-size: 40px;
            }

            .landing-footer-inner {
                align-items: flex-start;
            }
        }
    </style>
    @RenderSection("styles", required: false)
</head>
<body class="landing-body">
    @if (ViewBag.Preview != null && (bool)ViewBag.Preview)
    {
        <div class="landing-preview-bar">
            Preview mode - hidden sections are visible here only.
            <a href="@Url.Action("Index", "LandingAdmin")">Back to landing content</a>
        </div>
    }

    <header class="landing-header">
        <div class="landing-container landing-header-inner">
            <a href="@Url.Action("Index", "Home")" class="landing-logo">
                <img src="@logoUrl" alt="@appSettings.CompanyName">
            </a>

            <nav class="landing-nav">
                <a href="#features">Features</a>
                <a href="#about">About</a>
                <a href="#faq">FAQ</a>
            </nav>

            <div class="landing-header-actions">
                @if (User.Identity.IsAuthenticated)
                {
                    <a href="@Url.Action("Index", "Dashboard")" class="landing-btn landing-btn-primary landing-btn-sm">Dashboard</a>
                }
                else
                {
                    <a href="@Url.Action("Login", "Account")" class="landing-btn landing-btn-ghost landing-btn-sm">Sign in</a>
                    <a href="@Url.Action("Register", "Account")" class="landing-btn landing-btn-primary landing-btn-sm">Get started</a>
                }
            </div>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="landing-footer">
        <div class="landing-container landing-footer-inner">
            <div>
                <strong>@appSettings.CompanyName</strong>
                <p>@(appSettings.Tagline ?? "Personal health and fitness management")</p>
            </div>
            <div class="landing-footer-links">
                <a href="#features">Features</a>
                <a href="#faq">FAQ</a>
                @if (!string.IsNullOrWhiteSpace(appSettings.SupportEmail))
                {
                    <a href="mailto:@appSettings.SupportEmail">Support</a>
                }
                <span>&copy; @DateTime.Now.Year @appSettings.CompanyName</span>
            </div>
        </div>
    </footer>

    @Html.Partial("_FooterScripts")
    @RenderSection("scripts", required: false)
</body>
</html>
