<!-- Page Title Start -->
<div class="flex items-center md:justify-between flex-wrap gap-2 mb-6">
    <h4 class="text-default-900 text-lg font-medium mb-2">@ViewBag.Title</h4>

    <div class="md:flex hidden items-center gap-3 text-sm font-semibold">
        <a href="@Url.Action("Index", "Home")" class="text-sm font-medium text-default-700">@coursework_2.Models.SettingsService.Current.CompanyName</a>
        <i class="material-symbols-rounded text-xl flex-shrink-0 text-default-500">chevron_right</i>
        <a href="#" class="text-sm font-medium text-default-700">@ViewBag.Subtitle</a>
        <i class="material-symbols-rounded text-xl flex-shrink-0 text-default-500">chevron_right</i>
        <a href="#" class="text-sm font-medium text-default-700" aria-current="page">@ViewBag.Title</a>
    </div>
</div>
<!-- Page Title End -->
