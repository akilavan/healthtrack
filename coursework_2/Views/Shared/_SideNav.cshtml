                </li>

                <li class="menu-item">
                    <a class="group flex items-center gap-x-3.5 rounded-md px-3 py-2 text-sm font-medium text-default-700 transition-all hover:bg-default-900/5 @on("Exercises")"
                       href="@Url.Action("Index", "Exercises")">
                        <span class="material-symbols-rounded text-xl">exercise</span>
                        Exercise Library
                    </a>
                </li>

                <li class="menu-item">
                    <a class="group flex items-center gap-x-3.5 rounded-md px-3 py-2 text-sm font-medium text-default-700 transition-all hover:bg-default-900/5 @on("Feedback")"
                       href="@Url.Action("Index", "Feedback")">
                        <span class="material-symbols-rounded text-xl">reviews</span>
                        Give Feedback
                    </a>
                </li>
                <li class="menu-item">
                    <a class="group flex items-center gap-x-3.5 rounded-md px-3 py-2 text-sm font-medium text-default-700 transition-all hover:bg-default-900/5 @on("Reports")"
                       href="@Url.Action("Index", "Reports")">
