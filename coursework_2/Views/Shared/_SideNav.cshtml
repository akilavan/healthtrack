                       href="@Url.Action("Index", "Feedback")">
                        <span class="material-symbols-rounded text-xl">reviews</span>
                        Trainer Feedback
                    </a>
                </li>
            }
            else if (role == "Trainer")
            {
                <li class="px-5 py-2 text-sm font-medium text-default-600">Coaching</li>

                <li class="menu-item">
                    <a class="group flex items-center gap-x-3.5 rounded-md px-3 py-2 text-sm font-medium text-default-700 transition-all hover:bg-default-900/5 @on("Clients")"
                       href="@Url.Action("Index", "Clients")">
