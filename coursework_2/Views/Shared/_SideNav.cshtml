                </li>
                <li class="menu-item">
                    <a class="group flex items-center gap-x-3.5 rounded-md px-3 py-2 text-sm font-medium text-default-700 transition-all hover:bg-default-900/5 @on("Providers")"
                       href="@Url.Action("Index", "Providers")">
