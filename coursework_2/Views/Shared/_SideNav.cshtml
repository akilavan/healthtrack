                        My Clients
                    </a>
                </li>

                <li class="menu-item">
                    <a class="group flex items-center gap-x-3.5 rounded-md px-3 py-2 text-sm font-medium text-default-700 transition-all hover:bg-default-900/5 @on("Workouts")"
                       href="@Url.Action("Index", "Workouts")">
                        <span class="material-symbols-rounded text-xl">fitness_center</span>
                        Workout Plans
                    </a>
                </li>

                <li class="menu-item">
                    <a class="group flex items-center gap-x-3.5 rounded-md px-3 py-2 text-sm font-medium text-default-700 transition-all hover:bg-default-900/5 @on("Diets")"
                       href="@Url.Action("Index", "Diets")">
                        <span class="material-symbols-rounded text-xl">restaurant</span>
