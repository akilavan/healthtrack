                        Appointments
                    </a>
                </li>

                <li class="menu-item">
                    <a class="group flex items-center gap-x-3.5 rounded-md px-3 py-2 text-sm font-medium text-default-700 transition-all hover:bg-default-900/5 @on("Reports")"
                       href="@Url.Action("Index", "Reports")">
                        <span class="material-symbols-rounded text-xl">bar_chart</span>
                        Reports
                    </a>
                </li>

                <li class="menu-item">
                    <a class="group flex items-center gap-x-3.5 rounded-md px-3 py-2 text-sm font-medium text-default-700 transition-all hover:bg-default-900/5 @on("AuditLogs")"
                       href="@Url.Action("Index", "AuditLogs")">
                        <span class="material-symbols-rounded text-xl">receipt_long</span>
                        Audit Logs
                    </a>
                </li>
                <li class="menu-item">
                    <a class="group flex items-center gap-x-3.5 rounded-md px-3 py-2 text-sm font-medium text-default-700 transition-all hover:bg-default-900/5 @on("LandingAdmin")"
                       href="@Url.Action("Index", "LandingAdmin")">
                        <span class="material-symbols-rounded text-xl">web</span>
                        Landing Page
                    </a>
                </li>
                <li class="menu-item">
                    <a class="group flex items-center gap-x-3.5 rounded-md px-3 py-2 text-sm font-medium text-default-700 transition-all hover:bg-default-900/5 @on("Settings")"
                       href="@Url.Action("Index", "Settings")">
                        <span class="material-symbols-rounded text-xl">settings</span>
                        Settings
                    </a>
                </li>
            }

            <li class="px-5 py-2 text-sm font-medium text-default-600">Account</li>

            <li class="menu-item">
                <a class="group flex items-center gap-x-3.5 rounded-md px-3 py-2 text-sm font-medium text-default-700 transition-all hover:bg-default-900/5 @on("Notifications")"
                   href="@Url.Action("Index", "Notifications")">
                    <span class="material-symbols-rounded text-xl">notifications</span>
                    Notifications
                    @if (unread > 0)
                    {
                        <span class="ms-auto inline-flex items-center justify-center size-5 rounded-full bg-danger text-white text-xs">@unread</span>
                    }
                </a>
            </li>

            <li class="menu-item">
                <a class="group flex items-center gap-x-3.5 rounded-md px-3 py-2 text-sm font-medium text-default-700 transition-all hover:bg-default-900/5 @on("Profile")"
                   href="@Url.Action("Index", "Profile")">
                    <span class="material-symbols-rounded text-xl">person</span>
                    My Profile
                </a>
            </li>

            <li class="menu-item">
                <a class="group flex items-center gap-x-3.5 rounded-md px-3 py-2 text-sm font-medium text-danger transition-all hover:bg-danger/10"
